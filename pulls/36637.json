      "html_url": "https://github.com/jpk68",
      "followers_url": "https://api.github.com/users/jpk68/followers",
      "following_url": "https://api.github.com/users/jpk68/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/jpk68/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/jpk68/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/jpk68/subscriptions",
      "organizations_url": "https://api.github.com/users/jpk68/orgs",
      "repos_url": "https://api.github.com/users/jpk68/repos",

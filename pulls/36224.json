      "subscriptions_url": "https://api.github.com/users/nebula-21/subscriptions",
      "organizations_url": "https://api.github.com/users/nebula-21/orgs",
      "repos_url": "https://api.github.com/users/nebula-21/repos",
      "events_url": "https://api.github.com/users/nebula-21/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/nebula-21/received_events",

    "title": "psbt: drop Taproot and MuSig2 signatures when adding an input",
    "user": {
      "login": "Ravan002",
      "id": 95362051,
      "node_id": "U_kgDOBa8cAw",
      "avatar_url": "https://avatars.githubusercontent.com/u/95362051?v=4",

    "locked": false,
    "maintainer_can_modify": true,
    "title": "kernel: handle null mempool on chainstate deletion",
    "user": {
      "login": "l0rinc",
      "id": 1841944,
      "node_id": "MDQ6VXNlcjE4NDE5NDQ=",

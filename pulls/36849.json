      "gists_url": "https://api.github.com/users/Pranav-error/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/Pranav-error/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/Pranav-error/subscriptions",
      "organizations_url": "https://api.github.com/users/Pranav-error/orgs",
      "repos_url": "https://api.github.com/users/Pranav-error/repos",
      "events_url": "https://api.github.com/users/Pranav-error/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/Pranav-error/received_events",

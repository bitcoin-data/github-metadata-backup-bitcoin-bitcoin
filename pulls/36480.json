    "title": "txospenderindex: hash keys and pack positions to reduce disk usage",
    "user": {
      "login": "arejula27",
      "id": 46299278,
      "node_id": "MDQ6VXNlcjQ2Mjk5Mjc4",
      "avatar_url": "https://avatars.githubusercontent.com/u/46299278?v=4",

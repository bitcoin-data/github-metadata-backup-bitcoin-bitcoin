      "tree": {
        "sha": "2bf634733d8ab8280c54401a8c2162545b1a602a",
        "url": "https://api.github.com/repos/bitcoin/bitcoin/git/trees/2bf634733d8ab8280c54401a8c2162545b1a602a"

    "locked": false,
    "maintainer_can_modify": true,
    "title": "wallet: add BIP39 mnemonic support to addhdkey",
    "user": {
      "login": "mateusz-klatt",
      "id": 107385657,
      "node_id": "U_kgDOBmaTOQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/107385657?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/mateusz-klatt",
      "html_url": "https://github.com/mateusz-klatt",
      "followers_url": "https://api.github.com/users/mateusz-klatt/followers",
      "following_url": "https://api.github.com/users/mateusz-klatt/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/mateusz-klatt/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/mateusz-klatt/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/mateusz-klatt/subscriptions",
      "organizations_url": "https://api.github.com/users/mateusz-klatt/orgs",
      "repos_url": "https://api.github.com/users/mateusz-klatt/repos",
      "events_url": "https://api.github.com/users/mateusz-klatt/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/mateusz-klatt/received_events",

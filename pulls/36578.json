      "commit_id": null,
      "commit_url": null,
      "created_at": "2026-10-21T10:14:43Z",
      "updated_at": "2026-10-21T10:14:43Z",
      "author_association": "MEMBER",
      "body": "Not sure,  the `Assume(false)`  removed is a no-op in release, and the replacement cleans the orphan only reactively when it's later re-selected as a 1p1c child. If that never happens, the orphan dangles until it expires. I'd rather we clean the orphanage proactively on mempool entry, via `TransactionAddedToMempool`? so an orphan that enters by any path  is removed regardless. This is redundant ofc with the existing p2p cleanup for relayed txs, but we need both: the notification is async and can be processed before the orphan is inserted (it's EraseTx then no-ops), so the synchronous p2p path still does useful work.\r\n```diff\r\ndiff --git a/src/net_processing.cpp b/src/net_processing.cpp\r\nindex ae329489e6..f23303605f 100644\r\n--- a/src/net_processing.cpp\r\n+++ b/src/net_processing.cpp\r\n@@ -576,6 +576,8 @@ public:\r\n     /** Overridden from CValidationInterface. */\r\n     void ActiveTipChange(const CBlockIndex& new_tip, bool) override\r\n         EXCLUSIVE_LOCKS_REQUIRED(!m_tx_download_mutex);\r\n+    void TransactionAddedToMempool(const NewMempoolTransactionInfo& tx, uint64_t mempool_sequence) override\r\n+        EXCLUSIVE_LOCKS_REQUIRED(!m_tx_download_mutex);\r\n     void BlockConnected(const ChainstateRole& role, const std::shared_ptr<const CBlock>& pblock, const CBlockIndex* pindexConnected) override\r\n         EXCLUSIVE_LOCKS_REQUIRED(!m_tx_download_mutex);\r\n     void BlockDisconnected(const std::shared_ptr<const CBlock> &block, const CBlockIndex* pindex) override\r\n@@ -2190,6 +2192,12 @@ void PeerManagerImpl::ActiveTipChange(const CBlockIndex& new_tip, bool is_ibd)\r\n     }\r\n }\r\n\r\n+void PeerManagerImpl::TransactionAddedToMempool(const NewMempoolTransactionInfo& tx, uint64_t mempool_sequence)\r\n+{\r\n+    LOCK(m_tx_download_mutex);\r\n+    m_txdownloadman.MempoolAcceptedTx(tx.info.m_tx);\r\n+}\r\n+\r\n /**\r\n  * Evict orphan txn pool entries based on a newly connected\r\n  * block, remember the recently confirmed transactions, and delete tracked\r\ndiff --git a/test/functional/p2p_orphan_handling.py b/test/functional/p2p_orphan_handling.py\r\nindex b6e521dbe4..056bd72823 100755\r\n--- a/test/functional/p2p_orphan_handling.py\r\n+++ b/test/functional/p2p_orphan_handling.py\r\n@@ -841,7 +841,7 @@ class OrphanHandlingTest(BitcoinTestFramework):\r\n\r\n     @cleanup\r\n     def test_orphan_in_mempool(self):\r\n-        self.log.info(\"Test that an orphan in the mempool is removed from the orphanage when found as the child of a 1p1c package\")\r\n+        self.log.info(\"Test that an orphan is removed from the orphanage when it enters the mempool other than through peer relay\")\r\n         node = self.nodes[0]\r\n         parent = self.wallet.create_self_transfer(fee_rate=0)\r\n         child = self.wallet.create_self_transfer(utxo_to_spend=parent[\"new_utxo\"])\r\n@@ -854,12 +854,10 @@ class OrphanHandlingTest(BitcoinTestFramework):\r\n         peer.send_and_ping(msg_tx(child[\"tx\"]))\r\n         assert tx_in_orphanage(node, child[\"tx\"])\r\n\r\n-        # The child enters the mempool by RPC, which does not remove it from the orphanage.\r\n+        # The child enters the mempool by RPC. Even though this is not through peer relay, it is\r\n+        # still removed from the orphanage.\r\n         assert_equal(node.submitpackage([parent[\"hex\"], child[\"hex\"]])[\"package_msg\"], \"success\")\r\n-        assert tx_in_orphanage(node, child[\"tx\"])\r\n-\r\n-        # The same parent version is paired with the orphan, which turns out to be in the mempool.\r\n-        peer.send_and_ping(msg_tx(parent_bad_wit))\r\n+        node.syncwithvalidationinterfacequeue()\r\n         assert not tx_in_orphanage(node, child[\"tx\"])\r\n         assert child[\"txid\"] in node.getrawmempool()\r\n\r\n\r\n```",
      "user": {
        "login": "ismaelsadeeq",
        "id": 48946461,
        "node_id": "MDQ6VXNlcjQ4OTQ2NDYx",
        "avatar_url": "https://avatars.githubusercontent.com/u/48946461?v=4",
        "gravatar_id": "",
        "url": "https://api.github.com/users/ismaelsadeeq",
        "html_url": "https://github.com/ismaelsadeeq",
        "followers_url": "https://api.github.com/users/ismaelsadeeq/followers",
        "following_url": "https://api.github.com/users/ismaelsadeeq/following%7B/other_user%7D",
        "gists_url": "https://api.github.com/users/ismaelsadeeq/gists%7B/gist_id%7D",
        "starred_url": "https://api.github.com/users/ismaelsadeeq/starred%7B/owner%7D%7B/repo%7D",
        "subscriptions_url": "https://api.github.com/users/ismaelsadeeq/subscriptions",

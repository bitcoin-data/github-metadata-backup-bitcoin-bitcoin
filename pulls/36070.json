      "tree": {
        "sha": "0124775fdf6303f4812e1afdcab8493f644ddd32",
        "url": "https://api.github.com/repos/bitcoin/bitcoin/git/trees/0124775fdf6303f4812e1afdcab8493f644ddd32"

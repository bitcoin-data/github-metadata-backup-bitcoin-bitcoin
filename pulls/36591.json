    "maintainer_can_modify": false,
    "title": "test: deduplicate PSBT unknown-field coverage in `rpc_psbt.py`",
    "user": {
      "login": "nebula-21",
      "id": 53496928,
      "node_id": "MDQ6VXNlcjUzNDk2OTI4",

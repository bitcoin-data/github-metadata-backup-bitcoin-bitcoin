    "title": "devtools: support multiple include dirs in circular dependency check",
    "user": {
      "login": "birdrust",
      "id": 317007942,
      "node_id": "U_kgDOEuUoRg",
      "avatar_url": "https://avatars.githubusercontent.com/u/317007942?v=4",

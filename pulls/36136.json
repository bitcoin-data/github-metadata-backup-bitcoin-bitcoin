    "title": "rpc: remove stale \"canonical form\" claim from getdescriptorinfo help",
    "user": {
      "login": "craigraw",
      "id": 862166,
      "node_id": "MDQ6VXNlcjg2MjE2Ng==",
      "avatar_url": "https://avatars.githubusercontent.com/u/862166?v=4",
      "gravatar_id": "",

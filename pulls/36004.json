    "maintainer_can_modify": true,
    "title": "descriptor: warn about multipath key reuse",
    "user": {
      "login": "Dontbyshai",
      "id": 66849620,
      "node_id": "MDQ6VXNlcjY2ODQ5NjIw",
      "avatar_url": "https://avatars.githubusercontent.com/u/66849620?v=4",
      "gravatar_id": "",

    "title": "contrib: fix crash in message-capture-parser.py on non-printable msgtype",
    "user": {
      "login": "CapThunder19",
      "id": 161865581,
      "node_id": "U_kgDOCaXfbQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/161865581?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/CapThunder19",
      "html_url": "https://github.com/CapThunder19",
      "followers_url": "https://api.github.com/users/CapThunder19/followers",
      "following_url": "https://api.github.com/users/CapThunder19/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/CapThunder19/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/CapThunder19/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/CapThunder19/subscriptions",
      "organizations_url": "https://api.github.com/users/CapThunder19/orgs",
      "repos_url": "https://api.github.com/users/CapThunder19/repos",
      "events_url": "https://api.github.com/users/CapThunder19/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/CapThunder19/received_events",
      "type": "User",

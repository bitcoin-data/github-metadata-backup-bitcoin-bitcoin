    "title": "bip352: verify redeem script and pubkey hash in GetPubKeyFromInput",
    "user": {
      "login": "Yudis-bit",
      "id": 85178972,
      "node_id": "MDQ6VXNlcjg1MTc4OTcy",
      "avatar_url": "https://avatars.githubusercontent.com/u/85178972?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/Yudis-bit",
      "html_url": "https://github.com/Yudis-bit",
      "followers_url": "https://api.github.com/users/Yudis-bit/followers",
      "following_url": "https://api.github.com/users/Yudis-bit/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/Yudis-bit/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/Yudis-bit/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/Yudis-bit/subscriptions",
      "organizations_url": "https://api.github.com/users/Yudis-bit/orgs",
      "repos_url": "https://api.github.com/users/Yudis-bit/repos",
      "events_url": "https://api.github.com/users/Yudis-bit/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/Yudis-bit/received_events",

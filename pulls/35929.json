    "title": "guix, depends: Omit `GUIX_ENVIRONMENT` from `gen_id` calculations",
    "user": {
      "login": "hebasto",
      "id": 32963518,
      "node_id": "MDQ6VXNlcjMyOTYzNTE4",
      "avatar_url": "https://avatars.githubusercontent.com/u/32963518?v=4",

    "maintainer_can_modify": true,
    "title": "rpc, wallet: Convert walletprocesspsbt to use options parameter",
    "user": {
      "login": "jeanpablojp",
      "id": 8968629,
      "node_id": "MDQ6VXNlcjg5Njg2Mjk=",
      "avatar_url": "https://avatars.githubusercontent.com/u/8968629?v=4",
      "gravatar_id": "",

      "gists_url": "https://api.github.com/users/jespada/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/jespada/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/jespada/subscriptions",
      "organizations_url": "https://api.github.com/users/jespada/orgs",
      "repos_url": "https://api.github.com/users/jespada/repos",
      "events_url": "https://api.github.com/users/jespada/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/jespada/received_events",

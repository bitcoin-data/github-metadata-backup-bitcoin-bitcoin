      "starred_url": "https://api.github.com/users/kah-ja/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/kah-ja/subscriptions",
      "organizations_url": "https://api.github.com/users/kah-ja/orgs",
      "repos_url": "https://api.github.com/users/kah-ja/repos",

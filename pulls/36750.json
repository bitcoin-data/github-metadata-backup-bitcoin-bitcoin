    "title": "test: construct multisig_tests inputs/outputs declaratively",
    "user": {
      "login": "yuvicc",
      "id": 92994932,
      "node_id": "U_kgDOBYr9dA",
      "avatar_url": "https://avatars.githubusercontent.com/u/92994932?v=4",

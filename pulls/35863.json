      "subscriptions_url": "https://api.github.com/users/jeanpablojp/subscriptions",
      "organizations_url": "https://api.github.com/users/jeanpablojp/orgs",
      "repos_url": "https://api.github.com/users/jeanpablojp/repos",
      "events_url": "https://api.github.com/users/jeanpablojp/events%7B/privacy%7D",

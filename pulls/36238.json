    "title": "wallet, rpc: fix importdescriptors crash on int32_t range end overflow",
    "user": {
      "login": "kriss39",
      "id": 93033289,
      "node_id": "U_kgDOBYuTSQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/93033289?v=4",
      "gravatar_id": "",

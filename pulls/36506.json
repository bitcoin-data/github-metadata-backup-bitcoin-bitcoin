      "node_id": "C_kwDOABII59oAKDczY2UzMGY1NTU5YzI3NTMwOTEyODRmNmUzYjkyNmEwYTMxOWEwZjc",
      "url": "https://api.github.com/repos/bitcoin/bitcoin/git/commits/73ce30f5559c2753091284f6e3b926a0a319a0f7",
      "actor": null,

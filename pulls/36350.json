    "title": "net_processing: count presync work in chain sync eviction",
    "user": {
      "login": "0xShadowX",
      "id": 146137079,
      "node_id": "U_kgDOCLXf9w",
      "avatar_url": "https://avatars.githubusercontent.com/u/146137079?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/0xShadowX",
      "html_url": "https://github.com/0xShadowX",
      "followers_url": "https://api.github.com/users/0xShadowX/followers",
      "following_url": "https://api.github.com/users/0xShadowX/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/0xShadowX/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/0xShadowX/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/0xShadowX/subscriptions",
      "organizations_url": "https://api.github.com/users/0xShadowX/orgs",
      "repos_url": "https://api.github.com/users/0xShadowX/repos",
      "events_url": "https://api.github.com/users/0xShadowX/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/0xShadowX/received_events",
      "type": "User",
      "site_admin": false,
      "name": null,

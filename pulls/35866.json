    "locked": false,
    "maintainer_can_modify": true,
    "title": "test: Verify unwelcome RPC clients are rejected before reading their requests",
    "user": {
      "login": "winterrdog",
      "id": 87463258,
      "node_id": "MDQ6VXNlcjg3NDYzMjU4",
      "avatar_url": "https://avatars.githubusercontent.com/u/87463258?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/winterrdog",
      "html_url": "https://github.com/winterrdog",
      "followers_url": "https://api.github.com/users/winterrdog/followers",
      "following_url": "https://api.github.com/users/winterrdog/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/winterrdog/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/winterrdog/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/winterrdog/subscriptions",
      "organizations_url": "https://api.github.com/users/winterrdog/orgs",
      "repos_url": "https://api.github.com/users/winterrdog/repos",
      "events_url": "https://api.github.com/users/winterrdog/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/winterrdog/received_events",
      "type": "User",
      "site_admin": false,
      "name": null,
      "patch_url": null
    },
    "body": "this is a follow-up PR from a suggestion in this [comment](https://github.com/bitcoin/bitcoin/pull/35592#pullrequestreview-4823271031)\r\n\r\nit adds a unit test that confirms that clients not permitted by\r\n`-rpcallowip` are rejected immediately after `accept()`, before any\r\nrequest bytes are read from the socket\r\n\r\nspecifically, the test checks that: no request is ever dispatched to the\r\nserver's request handler, the connection is closed without any response\r\nto the client, no `HTTPRemoteClient` is ever registered for it, and the\r\nclient's request bytes are left completely unread in the socket's\r\nreceive buffer",
    "labels": [

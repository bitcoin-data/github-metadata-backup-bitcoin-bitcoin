    "title": "psbt: clear Taproot and MuSig2 signatures when joining",
    "user": {
      "login": "FlashWayne",
      "id": 332458478,
      "node_id": "U_kgDOE9Dp7g",
      "avatar_url": "https://avatars.githubusercontent.com/u/332458478?v=4",

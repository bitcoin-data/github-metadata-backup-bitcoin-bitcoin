    "title": "wallet: check block availability before registering chain notifications in AttachChain",
    "user": {
      "login": "reginaldalfret",
      "id": 190122957,
      "node_id": "U_kgDOC1ULzQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/190122957?v=4",

      "subscriptions_url": "https://api.github.com/users/reginaldalfret/subscriptions",
      "organizations_url": "https://api.github.com/users/reginaldalfret/orgs",
      "repos_url": "https://api.github.com/users/reginaldalfret/repos",
      "events_url": "https://api.github.com/users/reginaldalfret/events%7B/privacy%7D",

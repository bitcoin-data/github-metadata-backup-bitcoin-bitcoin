    "title": "test: add getblockfilter test coverage for header-only blocks",
    "user": {
      "login": "aaron-leeb",
      "id": 156447042,
      "node_id": "U_kgDOCVMxQg",
      "avatar_url": "https://avatars.githubusercontent.com/u/156447042?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/aaron-leeb",
      "html_url": "https://github.com/aaron-leeb",
      "followers_url": "https://api.github.com/users/aaron-leeb/followers",
      "following_url": "https://api.github.com/users/aaron-leeb/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/aaron-leeb/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/aaron-leeb/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/aaron-leeb/subscriptions",
      "organizations_url": "https://api.github.com/users/aaron-leeb/orgs",
      "repos_url": "https://api.github.com/users/aaron-leeb/repos",
      "events_url": "https://api.github.com/users/aaron-leeb/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/aaron-leeb/received_events",
      "type": "User",

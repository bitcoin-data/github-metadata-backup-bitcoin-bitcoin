    "locked": false,
    "maintainer_can_modify": true,
    "title": "torcontrol: escape backslashes in -torpassword",
    "user": {
      "login": "0xShadowX",
      "id": 146137079,
      "node_id": "U_kgDOCLXf9w",
      "avatar_url": "https://avatars.githubusercontent.com/u/146137079?v=4",

      "html_url": "https://github.com/650DataNerd",
      "followers_url": "https://api.github.com/users/650DataNerd/followers",
      "following_url": "https://api.github.com/users/650DataNerd/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/650DataNerd/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/650DataNerd/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/650DataNerd/subscriptions",
      "organizations_url": "https://api.github.com/users/650DataNerd/orgs",
      "repos_url": "https://api.github.com/users/650DataNerd/repos",
      "events_url": "https://api.github.com/users/650DataNerd/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/650DataNerd/received_events",
      "type": "User",
      "site_admin": false,

      "html_url": "https://github.com/alerodriargui",
      "followers_url": "https://api.github.com/users/alerodriargui/followers",
      "following_url": "https://api.github.com/users/alerodriargui/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/alerodriargui/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/alerodriargui/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/alerodriargui/subscriptions",
      "organizations_url": "https://api.github.com/users/alerodriargui/orgs",
      "repos_url": "https://api.github.com/users/alerodriargui/repos",
      "events_url": "https://api.github.com/users/alerodriargui/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/alerodriargui/received_events",
      "type": "User",

    "title": "test: avoid http.client for malformed header checks",
    "user": {
      "login": "alerodriargui",
      "id": 80339818,
      "node_id": "MDQ6VXNlcjgwMzM5ODE4",
      "avatar_url": "https://avatars.githubusercontent.com/u/80339818?v=4",
      "gravatar_id": "",

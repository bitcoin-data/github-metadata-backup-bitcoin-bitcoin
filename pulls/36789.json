    "title": "txindex: report iterator errors from FindTx",
    "user": {
      "login": "musaHaruna",
      "id": 124810379,
      "node_id": "U_kgDOB3B0iw",
      "avatar_url": "https://avatars.githubusercontent.com/u/124810379?v=4",

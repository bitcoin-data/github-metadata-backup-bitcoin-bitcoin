    "title": "wallet: fix crash when external signer wallet creation fails",
    "user": {
      "login": "zerog975",
      "id": 114834752,
      "node_id": "U_kgDOBtg9QA",
      "avatar_url": "https://avatars.githubusercontent.com/u/114834752?v=4",

      "followers_url": "https://api.github.com/users/zerog975/followers",
      "following_url": "https://api.github.com/users/zerog975/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/zerog975/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/zerog975/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/zerog975/subscriptions",
      "organizations_url": "https://api.github.com/users/zerog975/orgs",
      "repos_url": "https://api.github.com/users/zerog975/repos",
      "events_url": "https://api.github.com/users/zerog975/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/zerog975/received_events",

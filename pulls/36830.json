    "title": "test: make `tx_mempool_block_doublespend` cases independent",
    "user": {
      "login": "alexanderwiederin",
      "id": 37130778,
      "node_id": "MDQ6VXNlcjM3MTMwNzc4",
      "avatar_url": "https://avatars.githubusercontent.com/u/37130778?v=4",

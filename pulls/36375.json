    "locked": false,
    "maintainer_can_modify": true,
    "title": "wallet: accept uppercase addresses without amount in sendall",
    "user": {
      "login": "FlashWayne",
      "id": 332458478,
      "node_id": "U_kgDOE9Dp7g",
      "avatar_url": "https://avatars.githubusercontent.com/u/332458478?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/FlashWayne",
      "html_url": "https://github.com/FlashWayne",
      "followers_url": "https://api.github.com/users/FlashWayne/followers",
      "following_url": "https://api.github.com/users/FlashWayne/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/FlashWayne/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/FlashWayne/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/FlashWayne/subscriptions",
      "organizations_url": "https://api.github.com/users/FlashWayne/orgs",
      "repos_url": "https://api.github.com/users/FlashWayne/repos",
      "events_url": "https://api.github.com/users/FlashWayne/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/FlashWayne/received_events",

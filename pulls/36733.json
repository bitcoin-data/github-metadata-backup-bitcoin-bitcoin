    "title": "txgraph: use real intra-cluster dependencies in Trim()",
    "user": {
      "login": "bazzoneto",
      "id": 61053356,
      "node_id": "MDQ6VXNlcjYxMDUzMzU2",
      "avatar_url": "https://avatars.githubusercontent.com/u/61053356?v=4",

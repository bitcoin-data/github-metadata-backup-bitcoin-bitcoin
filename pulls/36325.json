      "node_id": "C_kwDOABII59oAKDg2NjRmNmRjNDUwMTZiNTczMDljOGNiZmUyNjZkZGI0MzdjYzQ3ZTA",
      "url": "https://api.github.com/repos/bitcoin/bitcoin/git/commits/8664f6dc45016b57309c8cbfe266ddb437cc47e0",
      "actor": null,
      "commit_id": null,
      "commit_url": null,
      "created_at": null,
      "html_url": "https://github.com/bitcoin/bitcoin/commit/8664f6dc45016b57309c8cbfe266ddb437cc47e0",
      "tree": {
        "sha": "98f311ae5e2242214347914ea5f20c5294430fdf",
        "url": "https://api.github.com/repos/bitcoin/bitcoin/git/trees/98f311ae5e2242214347914ea5f20c5294430fdf"
      },
      "verification": {
        "verified": true,

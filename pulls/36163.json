    "locked": false,
    "maintainer_can_modify": false,
    "title": "test: Add coverage for unsatisfiable locktime combination in PSBT `ComputeTimeLock()`",
    "user": {
      "login": "nebula-21",
      "id": 53496928,
      "node_id": "MDQ6VXNlcjUzNDk2OTI4",
      "avatar_url": "https://avatars.githubusercontent.com/u/53496928?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/nebula-21",
      "html_url": "https://github.com/nebula-21",
      "followers_url": "https://api.github.com/users/nebula-21/followers",
      "following_url": "https://api.github.com/users/nebula-21/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/nebula-21/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/nebula-21/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/nebula-21/subscriptions",
      "organizations_url": "https://api.github.com/users/nebula-21/orgs",
      "repos_url": "https://api.github.com/users/nebula-21/repos",
      "events_url": "https://api.github.com/users/nebula-21/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/nebula-21/received_events",
      "type": "User",
      "site_admin": false,
      "name": null,

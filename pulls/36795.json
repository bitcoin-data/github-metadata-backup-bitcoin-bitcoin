    "locked": false,
    "maintainer_can_modify": true,
    "title": "ipc: accept max-connections on bare unix -ipcbind address",
    "user": {
      "login": "Naomi-Gift",
      "id": 149405096,
      "node_id": "U_kgDOCOe9qA",

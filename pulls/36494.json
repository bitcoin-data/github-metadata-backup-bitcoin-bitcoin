    "maintainer_can_modify": true,
    "title": "wallet: reject unknown options in sendall",
    "user": {
      "login": "thomasbuilds",
      "id": 143176954,
      "node_id": "U_kgDOCIi0-g",
      "avatar_url": "https://avatars.githubusercontent.com/u/143176954?v=4",

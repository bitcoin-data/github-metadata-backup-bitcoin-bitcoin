    "title": "contrib: fix dead null-byte check in linearize-data.py",
    "user": {
      "login": "aman21-droid",
      "id": 185273612,
      "node_id": "U_kgDOCwsNDA",
      "avatar_url": "https://avatars.githubusercontent.com/u/185273612?v=4",

      "subscriptions_url": "https://api.github.com/users/aman21-droid/subscriptions",
      "organizations_url": "https://api.github.com/users/aman21-droid/orgs",
      "repos_url": "https://api.github.com/users/aman21-droid/repos",
      "events_url": "https://api.github.com/users/aman21-droid/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/aman21-droid/received_events",

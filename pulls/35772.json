    "title": "http: drop connections from RPC clients that are not allowed to connect",
    "user": {
      "login": "janb84",
      "id": 608446,
      "node_id": "MDQ6VXNlcjYwODQ0Ng==",
      "avatar_url": "https://avatars.githubusercontent.com/u/608446?v=4",

      "diff_hunk": "@@ -179,14 +180,29 @@ std::optional<PubKey> GetPubKeyFromInput(const CTxIn& txin, const CScript& spk)\n     }\n \n     if (type == TxoutType::PUBKEYHASH) {\n-        std::vector<std::vector<unsigned char>> stack;\n-        if (!EvalScript(stack, txin.scriptSig, SCRIPT_VERIFY_NONE, DUMMY_CHECKER, SigVersion::BASE)) {\n-            return std::nullopt;\n+        // For P2PKH public key extraction, BIP-352 states: \"The receiver MUST parse the scriptSig\n+        // for the public key, even if the scriptSig does not match the template specified. This is\n+        // to address the third-party malleability of P2PKH scriptSigs.\"\n+        //\n+        // Find the preimage of the public key hash by iterating through the scriptSig data\n+        // pushes and compare the Hash160 of each 33-byte push against the output script.\n+        // Note that in standard P2PKH spends the pubkey would always be the last data push,\n+        // but due to malleability we can't rely on that, as the scriptSig may have been\n+        // modified arbitrarily, e.g. by inserting `<dummy_push> OP_DROP` at any position.",

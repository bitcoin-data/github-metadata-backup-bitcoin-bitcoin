    "title": "blockstorage: fail instead of storing a null XOR key over a lost one",
    "user": {
      "login": "kwsantiago",
      "id": 44934418,
      "node_id": "MDQ6VXNlcjQ0OTM0NDE4",
      "avatar_url": "https://avatars.githubusercontent.com/u/44934418?v=4",
      "gravatar_id": "",

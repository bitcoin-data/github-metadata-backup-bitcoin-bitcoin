      "following_url": "https://api.github.com/users/superuser547/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/superuser547/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/superuser547/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/superuser547/subscriptions",
      "organizations_url": "https://api.github.com/users/superuser547/orgs",
      "repos_url": "https://api.github.com/users/superuser547/repos",

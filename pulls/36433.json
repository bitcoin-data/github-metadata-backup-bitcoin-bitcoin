    "title": "contrib: avoid echoing supplied RPC passwords",
    "user": {
      "login": "superuser547",
      "id": 137869044,
      "node_id": "U_kgDOCDe29A",
      "avatar_url": "https://avatars.githubusercontent.com/u/137869044?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/superuser547",
      "html_url": "https://github.com/superuser547",

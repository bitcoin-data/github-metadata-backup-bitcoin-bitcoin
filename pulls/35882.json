      "following_url": "https://api.github.com/users/jeanpablojp/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/jeanpablojp/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/jeanpablojp/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/jeanpablojp/subscriptions",
      "organizations_url": "https://api.github.com/users/jeanpablojp/orgs",
      "repos_url": "https://api.github.com/users/jeanpablojp/repos",
      "events_url": "https://api.github.com/users/jeanpablojp/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/jeanpablojp/received_events",

    "maintainer_can_modify": true,
    "title": "test: cover Taproot standardness rules in mempool_accept",
    "user": {
      "login": "jeanpablojp",
      "id": 8968629,
      "node_id": "MDQ6VXNlcjg5Njg2Mjk=",

    "maintainer_can_modify": true,
    "title": "rpc: handle malformed jsonrpc 2.0 requests correctly",
    "user": {
      "login": "pinheadmz",
      "id": 2084648,
      "node_id": "MDQ6VXNlcjIwODQ2NDg=",

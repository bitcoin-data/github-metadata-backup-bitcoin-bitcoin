      "gists_url": "https://api.github.com/users/tialkan/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/tialkan/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/tialkan/subscriptions",
      "organizations_url": "https://api.github.com/users/tialkan/orgs",
      "repos_url": "https://api.github.com/users/tialkan/repos",

    "title": "test: cover outbound service flag filtering in ThreadOpenConnections",
    "user": {
      "login": "tialkan",
      "id": 267584739,
      "node_id": "U_kgDOD_ME4w",
      "avatar_url": "https://avatars.githubusercontent.com/u/267584739?v=4",

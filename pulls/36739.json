      "following_url": "https://api.github.com/users/pzafonte/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/pzafonte/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/pzafonte/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/pzafonte/subscriptions",
      "organizations_url": "https://api.github.com/users/pzafonte/orgs",
      "repos_url": "https://api.github.com/users/pzafonte/repos",
      "events_url": "https://api.github.com/users/pzafonte/events%7B/privacy%7D",

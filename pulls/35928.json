      "html_url": "https://github.com/cyb3ralbert",
      "followers_url": "https://api.github.com/users/cyb3ralbert/followers",
      "following_url": "https://api.github.com/users/cyb3ralbert/following%7B/other_user%7D",
      "gists_url": "https://api.github.com/users/cyb3ralbert/gists%7B/gist_id%7D",
      "starred_url": "https://api.github.com/users/cyb3ralbert/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/cyb3ralbert/subscriptions",
      "organizations_url": "https://api.github.com/users/cyb3ralbert/orgs",
      "repos_url": "https://api.github.com/users/cyb3ralbert/repos",
      "events_url": "https://api.github.com/users/cyb3ralbert/events%7B/privacy%7D",
      "received_events_url": "https://api.github.com/users/cyb3ralbert/received_events",

    "title": "doc: mention -DWITH_ZMQ=ON in macOS build guide",
    "user": {
      "login": "cyb3ralbert",
      "id": 6221107,
      "node_id": "MDQ6VXNlcjYyMjExMDc=",
      "avatar_url": "https://avatars.githubusercontent.com/u/6221107?v=4",
      "gravatar_id": "",

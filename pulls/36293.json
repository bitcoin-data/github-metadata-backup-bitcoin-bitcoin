    "maintainer_can_modify": true,
    "title": "contrib: prevent inactive keys from satisfying the binary verification quorum",
    "user": {
      "login": "l0rinc",
      "id": 1841944,
      "node_id": "MDQ6VXNlcjE4NDE5NDQ=",

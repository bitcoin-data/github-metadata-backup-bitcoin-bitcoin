      "starred_url": "https://api.github.com/users/kravens/starred%7B/owner%7D%7B/repo%7D",
      "subscriptions_url": "https://api.github.com/users/kravens/subscriptions",
      "organizations_url": "https://api.github.com/users/kravens/orgs",
      "repos_url": "https://api.github.com/users/kravens/repos",
      "events_url": "https://api.github.com/users/kravens/events%7B/privacy%7D",

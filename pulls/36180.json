    "maintainer_can_modify": true,
    "title": "qt: don't abort or drop settings when dynamic settings are disabled",
    "user": {
      "login": "jeanpablojp",
      "id": 8968629,
      "node_id": "MDQ6VXNlcjg5Njg2Mjk=",

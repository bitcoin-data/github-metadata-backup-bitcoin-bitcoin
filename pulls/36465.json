    "maintainer_can_modify": true,
    "title": "Test: Add P2SH scriptSig stack-size boundary tests",
    "user": {
      "login": "benthecarman",
      "id": 15256660,
      "node_id": "MDQ6VXNlcjE1MjU2NjYw",

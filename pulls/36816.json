    "locked": false,
    "maintainer_can_modify": true,
    "title": "policy: reject invalid CFeeRate values when deserializing",
    "user": {
      "login": "ryanofsky",
      "id": 7133040,
      "node_id": "MDQ6VXNlcjcxMzMwNDA=",

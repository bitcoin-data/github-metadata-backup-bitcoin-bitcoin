    "locked": false,
    "maintainer_can_modify": true,
    "title": "wallet: guard null coin control in AvailableCoins TRUC filter",
    "user": {
      "login": "brunoerg",
      "id": 19480819,
      "node_id": "MDQ6VXNlcjE5NDgwODE5",
      "avatar_url": "https://avatars.githubusercontent.com/u/19480819?v=4",
      "gravatar_id": "",

    "title": "wallet: Require the descriptors flag when the FLAGS record is missing",
    "user": {
      "login": "kah-ja",
      "id": 36455663,
      "node_id": "MDQ6VXNlcjM2NDU1NjYz",
      "avatar_url": "https://avatars.githubusercontent.com/u/36455663?v=4",

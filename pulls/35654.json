    "locked": false,
    "maintainer_can_modify": true,
    "title": "txdb: reject undecodable first coin cursor key",
    "user": {
      "login": "l0rinc",
      "id": 1841944,
      "node_id": "MDQ6VXNlcjE4NDE5NDQ=",
